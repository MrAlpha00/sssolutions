# ---------------------------------------------------------------------------
# Supportive HR Solutions — environment configuration
#
# Copy this file to `.env.local` and fill in the values you have.
# Every integration is OPTIONAL: the site runs without any of them.
#   - No Supabase  -> a local JSON data store (.data/db.json) is used instead
#   - No Resend    -> submissions are stored, email is skipped (never faked)
#   - No Turnstile -> the captcha widget is hidden and verification is skipped
#   - No Calendly key -> the configured default link is used (see site-config)
# NEVER commit real secrets. `.env*` is git-ignored.
# ---------------------------------------------------------------------------

# --- Site -------------------------------------------------------------------
# Used for canonical URLs, sitemap, robots, and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (optional) ----------------------------------------------------
# When NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY are set, the
# site automatically switches from the local JSON store to Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: server-only. Enables admin writes and private storage.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media
SUPABASE_PRIVATE_BUCKET=private

# --- Email via Resend (optional) --------------------------------------------
# RESEND_FROM_EMAIL must be a verified sender/domain in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Where contact + application notifications are delivered.
CONTACT_TO_EMAIL=

# --- Cloudflare Turnstile (optional) ----------------------------------------
# Both keys must be set for the captcha and server-side verification to run.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Public integrations (optional) -----------------------------------------
# Calendly scheduling link used by the "Book a Consultation" buttons.
# Defaults to the link configured in `src/lib/site-config.ts`; set this only to
# override it for an environment. Leave both blank to fall back to /contact.
NEXT_PUBLIC_CALENDLY_URL=
# Overrides the WhatsApp number from website settings (digits, with country code).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Admin authentication ---------------------------------------------------
# Required in production. Generate ADMIN_PASSWORD_HASH with:
#   npm run hash-password "your-strong-password"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=scrypt:6f81f170ccf8591360fe1f2359221e31:4840f179a2146669b40580faaf9bed201e9d39cd169dfb8325f3d09b6dc0917264a4d7cdc12c6854359f9c2e5af54e86edcd4b10622d1bad21358f22eec248ea
# Plaintext fallback — development convenience only. Prefer the hash above.
ADMIN_PASSWORD=
# Signs the admin session cookie. Use a long random string (32+ characters).
ADMIN_SESSION_SECRET=dhP6T6bZXayI3I6Jw1KlXnrRitSf5aSvG4an7qhl9ySOR-W2CLjG4roFC2EcVpWV
